# --- Backend (локальная разработка) ---
# Скопируйте этот файл в backend/.env и при необходимости измените значения:
#   Copy-Item .env.example .env

APP_NAME=AgentHR API
ENVIRONMENT=local

# Подключение к PostgreSQL из infra/ (docker compose, порт 5433)
DATABASE_URL=postgresql+asyncpg://agenthr:agenthr@localhost:5433/agenthr

# --- JWT (аутентификация) ---
# В продакшене обязательно заменить на длинный случайный секрет (32+ байта)!
JWT_SECRET_KEY=dev-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
