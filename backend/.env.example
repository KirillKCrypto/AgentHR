# Таймаут одного запроса, сек, и повторы SDK (0 — резервный запрос делает провайдер):
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=0

# --- CORS ---
# Браузерные источники, которым разрешены запросы (JSON-массив); по умолчанию frontend dev-сервер
# CORS_ORIGINS=["http://localhost:5173"]

# --- Agent Harness (лимиты цикла) ---
# AGENT_MAX_STEPS=10
# AGENT_TOKEN_BUDGET=50000
# AGENT_TIMEOUT_SECONDS=120
# AGENT_TOOL_TIMEOUT_SECONDS=30

# --- Эмбеддинги (нормализация навыков) ---
# Провайдер: none (по умолчанию — только alias и нечёткое совпадение),
# local (локальная ONNX-модель, бесплатно и без внешних сервисов) или mock (тесты).
# Для local поставьте пакет: uv sync --extra embeddings
# EMBEDDING_PROVIDER=none
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Порог косинусной близости, при котором навык сопоставляется с темой
# EMBEDDING_THRESHOLD=0.35
# Каталог кэша моделей (не коммитится)
# EMBEDDING_CACHE_DIR=.cache/fastembed
