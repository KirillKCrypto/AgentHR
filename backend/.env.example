# --- Backend (локальная разработка) ---
# Скопируйте этот файл в backend/.env и при необходимости измените значения:
#   Copy-Item .env.example .env

APP_NAME=AgentHR API
ENVIRONMENT=local

# Подключение к PostgreSQL из infra/ (docker compose, порт 5433)
DATABASE_URL=postgresql+asyncpg://agenthr:agenthr@localhost:5433/agenthr

# --- JWT (аутентификация) ---
# В продакшене обязательно заменить на длинный случайный секрет (32+ байта)!
JWT_SECRET_KEY=dev-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- LLM ---
# Провайдер: mock (по умолчанию, работает без сети) или openai
LLM_PROVIDER=mock
# Для LLM_PROVIDER=openai раскомментируйте и заполните:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=<актуальная модель OpenAI>

# --- CORS ---
# Браузерные источники, которым разрешены запросы (JSON-массив); по умолчанию frontend dev-сервер
# CORS_ORIGINS=["http://localhost:5173"]

# --- Agent Harness (лимиты цикла) ---
# AGENT_MAX_STEPS=10
# AGENT_TOKEN_BUDGET=50000
# AGENT_TIMEOUT_SECONDS=120
# AGENT_TOOL_TIMEOUT_SECONDS=30
