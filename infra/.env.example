# --- PostgreSQL (локальная разработка) ---
# Скопируйте этот файл в infra/.env и при необходимости измените значения:
#   Copy-Item .env.example .env

# Создаются при первой инициализации контейнера
POSTGRES_USER=agenthr
POSTGRES_PASSWORD=agenthr
POSTGRES_DB=agenthr

# Порт на хосте (5432 часто занят локальным PostgreSQL)
POSTGRES_PORT=5433
