# --- PostgreSQL (локальная разработка) ---
# Скопируйте этот файл в infra/.env и при необходимости измените значения:
#   Copy-Item .env.example .env

# Создаются при первой инициализации контейнера
POSTGRES_USER=agenthr
POSTGRES_PASSWORD=agenthr
POSTGRES_DB=agenthr

# Порт на хосте (5432 часто занят локальным PostgreSQL)
POSTGRES_PORT=5433

# --- Backend API (контейнер api) ---
# Порт API на хосте
API_PORT=8000

# Секрет JWT и LLM-настройки. Пустое значение = dev-дефолт приложения (compose
# подставит его через `${VAR:-default}`); для реальных вызовов LLM задайте
# LLM_PROVIDER=openai вместе с OPENAI_API_KEY и OPENAI_MODEL.
# Основной провайдер — DeepSeek (OpenAI-совместимый API):
# JWT_SECRET_KEY=
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=deepseek-flash
# OPENAI_BASE_URL=https://api.deepseek.com
# Режим структурированного вывода: json_schema (OpenAI), json_object (DeepSeek), prompt
# LLM_STRUCTURED_MODE=json_object
# Таймаут запроса к LLM, сек, и повторы SDK (0 — резервный запрос делает провайдер)
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=0

# Максимум новых provisional-тем на один документ (0 — всё в review-тему)
# AUTO_TOPIC_LIMIT=10

# Автоматическое ревью provisional-тем после сохранения документа
# ONTOLOGY_AUTO_REVIEW_ENABLED=true
# ONTOLOGY_AUTO_REVIEW_MIN_CONFIDENCE=0.75
# ONTOLOGY_AUTO_MERGE_SIMILARITY=0.9
# ONTOLOGY_AUTO_APPROVE_MIN_DOCUMENTS=2
# ONTOLOGY_AUTO_REVIEW_MAX_TOPICS=20

# Эмбеддинги для нормализации навыков: none (по умолчанию) или local.
# Для local образ API собирается с эмбеддингами:
#   docker compose build --build-arg UV_EXTRAS="--extra embeddings" api
# EMBEDDING_PROVIDER=none
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_THRESHOLD=0.35

# Браузерные источники для CORS (JSON-массив)
# CORS_ORIGINS=["http://localhost:5173"]
